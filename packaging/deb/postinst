#!/bin/sh
# Post-install for the `ironkey` package. Handles the three bits a .deb archive
# cannot carry itself: the file capability on the SCSI helper, the udev reload,
# and enabling + starting the systemd *user* agent. All best-effort — the tool
# works without any of them, so a failure here must not fail the install.
set -e

if [ "$1" = "configure" ]; then
    # Replug-free SCSI path needs CAP_SYS_RAWIO on the helper. Optional: without
    # it, reset falls back to the HID path (one physical replug).
    if command -v setcap >/dev/null 2>&1; then
        setcap cap_sys_rawio+ep /usr/bin/ironkey-scsi-helper 2>/dev/null \
            || echo "ironkey: could not set CAP_SYS_RAWIO on the SCSI helper; the replug-free SCSI reset will fall back to HID." >&2
    fi

    # Apply the udev uaccess rule so the drive's nodes are reachable without root.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=usb 2>/dev/null || true
    fi

    if command -v systemctl >/dev/null 2>&1; then
        # Enable for every user's future graphical login.
        systemctl --global enable ironkey-agent.service 2>/dev/null || true

        # Start it now in the session of the user who ran the install, so the
        # tray appears without a re-login. (A root postinst cannot reach a
        # running --user manager without this env.) Best-effort.
        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ] && command -v runuser >/dev/null 2>&1; then
            uid=$(id -u "$SUDO_USER" 2>/dev/null || echo)
            if [ -n "$uid" ] && [ -S "/run/user/$uid/bus" ]; then
                runuser -u "$SUDO_USER" -- env \
                    XDG_RUNTIME_DIR="/run/user/$uid" \
                    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                    sh -c 'systemctl --user daemon-reload; systemctl --user enable --now ironkey-agent.service' \
                    2>/dev/null \
                    || echo "ironkey: the agent is enabled and will start at your next login (or run: systemctl --user enable --now ironkey-agent)." >&2
            fi
        fi
    fi
fi

exit 0
