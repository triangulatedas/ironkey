[Unit]
Description=IronKey unlock agent (tray + auto-unlock prompt)
Documentation=https://github.com/triangulatedas/ironkey
After=graphical-session.target

[Service]
ExecStart=/usr/bin/ironkey-agent
Restart=on-failure
RestartSec=5

[Install]
# default.target is reached whenever the user's systemd manager starts (login),
# so the agent autostarts reliably across desktops. It degrades gracefully with
# no display (headless: no tray, no dialogs), so starting it always is safe.
WantedBy=default.target
